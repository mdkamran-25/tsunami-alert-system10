# Next.js Configuration - Railway Backend Only
# Railway provides all backend services (auth, database, real-time)

# GraphQL API - Railway Backend
NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://tsunami-alert-backend-production.up.railway.app/graphql
NEXT_PUBLIC_GRAPHQL_WS_ENDPOINT=wss://tsunami-alert-backend-production.up.railway.app/graphql

# Mapbox (Optional - for map display)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Analytics (Optional)
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Environment
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_VERSION=2.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_SUBSCRIPTIONS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
